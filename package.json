{
  "name": "friend-ride-qa",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit --target ES2020 --module none src/ride-contact.ts",
    "build:runtime": "tsc --target ES2020 --module none --outFile assets/ride-contact.js src/ride-contact.ts",
    "test:core": "vitest run",
    "typecheck:core": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
