{
  "name": "friend-ride-qa",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit --skipLibCheck --target ES2020 --module none src/ride-contact.ts",
    "build:runtime": "tsc --skipLibCheck --target ES2020 --module none --outFile assets/ride-contact.js src/ride-contact.ts",
    "test:core": "vitest run",
    "typecheck:core": "tsc -p tsconfig.json",
    "test:phase2": "playwright test qa/friend-ride.spec.cjs qa/tasko-laundry-main-regression.spec.js qa/tasko-laundry.spec.cjs qa/phase2-isolation.spec.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
